# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Auth
BETTER_AUTH_SECRET="replace-with-long-random-secret"
BETTER_AUTH_URL="http://localhost:3001"
TRUSTED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,relist://"

# CORS
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# URLs
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"

# Google OAuth (optional)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# AWS S3 (image uploads)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="relist-images"

# Stripe (API)
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Create recurring Price objects in your Stripe dashboard (one per plan/interval)
# and paste their IDs below. Every new subscription starts with a 7-day free trial
# (card required, charged automatically when the trial ends unless cancelled).
# To change a plan's price, create a new Price in Stripe and update the ID here —
# no code changes required.
#
# NOTE: Also add to apps/web/.env.local:
#   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Plan recurring price IDs (monthly + yearly)
STRIPE_SIDE_HUSTLE_PRICE_ID="price_..."         # $39.99 / month
STRIPE_SIDE_HUSTLE_YEARLY_PRICE_ID="price_..."  # $34.99 / month, billed annually
STRIPE_FULL_TIME_PRICE_ID="price_..."           # $64.99 / month
STRIPE_FULL_TIME_YEARLY_PRICE_ID="price_..."    # $59.99 / month, billed annually
# Enterprise is contact-sales — no self-serve price ID.

# Smart AI credit top-up (one-time Price object, sold in packs of 100)
STRIPE_AI_CREDITS_PRICE_ID="price_..."          # e.g. $15.00 per 100 credits

# AI product info generation
# Provider: openai (default) — swap by changing AI_PROVIDER
AI_PROVIDER=openai
AI_MODEL=gpt-4o
OPENAI_API_KEY="sk-..."

# PhotoRoom background removal API
# Get your API key at https://www.photoroom.com/api
PHOTOROOM_API_KEY=""

# Vendoo category API (used to seed MercariCategory table)
# sessionId is visible in the Vendoo network tab — update if it expires
VENDOO_SESSION_ID="a43f3bb2"
VENDOO_COOKIE=""   # Full Cookie header string from Vendoo network tab — update when session expires

# Residential proxy for Mercari Playwright requests (required in production on Railway)
# Cloudflare's JS challenge never resolves on datacenter IPs without a residential proxy.
# Affordable options: Smartproxy (~$200/mo), IPRoyal, Brightdata, Oxylabs
# Format: http://hostname:port  or  socks5://hostname:port
MERCARI_PROXY_SERVER=""
MERCARI_PROXY_USERNAME=""
MERCARI_PROXY_PASSWORD=""

# Browserless.io — used for Mercari login (apps/api/src/services/playwright/mercari-browserless.service.ts).
# Runs the login in Browserless's own residential-proxy/stealth Chrome fleet instead of our
# self-hosted Playwright browser, since Mercari's login is behind reCAPTCHA Enterprise.
# Get your token at https://cloud.browserless.io
BROWSERLESS_API_KEY=""
# Region subdomain, e.g. production-sfo, production-lon. Defaults to production-sfo.
BROWSERLESS_REGION=""

# CapSolver — solves Mercari's reCAPTCHA Enterprise challenge during credential login
# (apps/api/src/services/playwright/mercari-browserless.service.ts). Mercari's login uses
# score-based invisible reCAPTCHA Enterprise; without a solved token, automated logins get
# silently rejected by Mercari's backend even with correct credentials (no visible CAPTCHA
# popup — confirmed via live testing).
# Sign up and get your key at https://dashboard.capsolver.com
CAPSOLVER_API_KEY=""

# ZenRows — server-side Mercari publishing fallback for when the Chrome extension isn't
# available (apps/api/src/jobs/mercari-zenrows.worker.ts). ZenRows runs a real browser
# server-side to solve Mercari's Cloudflare managed challenge and provide a US IP (createListing
# is US-region-gated). The fallback is enabled only when BOTH ZENROWS_API_KEY and REDIS_URL are
# set; jobs the extension hasn't completed within the grace period are published via ZenRows.
# Get your key at https://app.zenrows.com
ZENROWS_API_KEY=""

# Country for the ZenRows residential proxy used for the photo upload (Mercari region-gates the
# upload endpoint to the US now). Two-letter code; defaults to "us". Uses the same ZENROWS_API_KEY.
ZENROWS_PROXY_COUNTRY=""

# Redis — backs the BullMQ queue used by the ZenRows fallback (delayed jobs persist here, so
# they survive restarts and work across multiple API instances; no Postgres polling).
# e.g. redis://localhost:6379 or a managed Redis URL (Upstash, Railway, etc.). Required for the
# ZenRows fallback; leave empty to disable it.
REDIS_URL=""

# How long (ms) to let the extension claim a job before the server publishes it via ZenRows.
# Default 90000. Also tunable: MERCARI_ZENROWS_ATTEMPTS (retry count, default 3) and
# MERCARI_ZENROWS_CONCURRENCY (parallel jobs, default 3).
MERCARI_ZENROWS_GRACE_MS=""

# eBay OAuth
# Get these from https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
EBAY_SANDBOX=true
# The redirect URI registered in your eBay developer account (RuName or URL).
# In sandbox: use the RuName from your sandbox app (e.g. "YourApp-YourApp-SBX-xxxxxxxx-xxxxxxxx").
# In production: use the full callback URL (e.g. "https://yourapp.com/api/marketplaces/oauth/ebay/callback").
# If unset, defaults to ${API_URL}/api/marketplaces/oauth/ebay/callback
EBAY_REDIRECT_URI=""

# eBay Marketplace Account Deletion webhook
# Configure at https://developer.ebay.com/my/push (Alerts and Notifications page)
# EBAY_DELETION_VERIFICATION_TOKEN — the token you set when registering the endpoint
# EBAY_DELETION_ENDPOINT_URL       — the exact public URL you registered (used in challenge hash)
#   e.g. "https://yourapp.com/api/webhooks/ebay/account-deletion"
EBAY_DELETION_VERIFICATION_TOKEN=""
EBAY_DELETION_ENDPOINT_URL="https://api.omventa.com/api/webhooks/ebay/account-deletion"
