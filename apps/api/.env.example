# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Auth
BETTER_AUTH_SECRET="replace-with-long-random-secret"
BETTER_AUTH_URL="http://localhost:3001"
TRUSTED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,relist://"

# CORS
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# URLs
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"

# Google OAuth (optional)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# AWS S3 (image uploads)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="relist-images"

# Stripe (API)
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Create three recurring Price objects in your Stripe dashboard (one per plan)
# and paste their IDs below.  To change a plan's price, create a new Price in
# Stripe and update the ID here — no code changes required.
STRIPE_STARTER_PRICE_ID="price_..."  # $9.99 / month — 50 credits
STRIPE_PRO_PRICE_ID="price_..."      # $24.99 / month — 200 credits
STRIPE_PREMIUM_PRICE_ID="price_..."  # $49.99 / month — 500 credits
#
# NOTE: Also add to apps/web/.env.local:
#   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Vendoo category API (used to seed MercariCategory table)
# sessionId is visible in the Vendoo network tab — update if it expires
VENDOO_SESSION_ID="a43f3bb2"
VENDOO_COOKIE=""   # Full Cookie header string from Vendoo network tab — update when session expires

# Residential proxy for Mercari Playwright requests (required in production on Railway)
# Cloudflare's JS challenge never resolves on datacenter IPs without a residential proxy.
# Affordable options: Smartproxy (~$200/mo), IPRoyal, Brightdata, Oxylabs
# Format: http://hostname:port  or  socks5://hostname:port
MERCARI_PROXY_SERVER=""
MERCARI_PROXY_USERNAME=""
MERCARI_PROXY_PASSWORD=""

# eBay OAuth
# Get these from https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
EBAY_SANDBOX=true
# The redirect URI registered in your eBay developer account (RuName or URL).
# In sandbox: use the RuName from your sandbox app (e.g. "YourApp-YourApp-SBX-xxxxxxxx-xxxxxxxx").
# In production: use the full callback URL (e.g. "https://yourapp.com/api/marketplaces/oauth/ebay/callback").
# If unset, defaults to ${API_URL}/api/marketplaces/oauth/ebay/callback
EBAY_REDIRECT_URI=""

# eBay Marketplace Account Deletion webhook
# Configure at https://developer.ebay.com/my/push (Alerts and Notifications page)
# EBAY_DELETION_VERIFICATION_TOKEN — the token you set when registering the endpoint
# EBAY_DELETION_ENDPOINT_URL       — the exact public URL you registered (used in challenge hash)
#   e.g. "https://yourapp.com/api/webhooks/ebay/account-deletion"
EBAY_DELETION_VERIFICATION_TOKEN=""
EBAY_DELETION_ENDPOINT_URL="https://api.omventa.com/api/webhooks/ebay/account-deletion"
