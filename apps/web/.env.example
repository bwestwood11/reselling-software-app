# API
NEXT_PUBLIC_API_URL=http://localhost:3001
# Optional: defaults to current web origin, used by Better Auth React client
# NEXT_PUBLIC_AUTH_URL=http://localhost:3000

# Better Auth
BETTER_AUTH_SECRET="generate-a-random-secret-here"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Mercari reCAPTCHA Enterprise site key (required for email/password Mercari login)
# Find it: on mercari.com open DevTools > Network > filter "recaptcha"
# Look for: google.com/recaptcha/enterprise.js?render=SITE_KEY
NEXT_PUBLIC_MERCARI_RECAPTCHA_SITE_KEY=""
