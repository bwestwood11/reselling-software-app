# API base URL used by the mobile app.
# For a physical phone on the same Wi-Fi, use your computer LAN IP.
# Example: EXPO_PUBLIC_API_URL="http://192.168.0.35:3001"
EXPO_PUBLIC_API_URL="http://localhost:3001"

# Better Auth checks the Origin header on auth POSTs.
# Keep this value aligned with apps/api TRUSTED_ORIGINS.
EXPO_PUBLIC_AUTH_ORIGIN="http://localhost:3000"
