generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

// ─── Better Auth Core Models ─────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions               Session[]
  accounts               Account[]
  marketplaceConnections MarketplaceConnection[]
  inventoryItems         InventoryItem[]
  listings               Listing[]
  subscription           Subscription?
  creditTransactions     CreditTransaction[]
  mercariJobs            MercariJob[]
  poshmarkJobs           PoshmarkJob[]
  sources                Source[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Marketplace Enums ────────────────────────────────────────────────────────

enum MarketplaceType {
  EBAY
  FACEBOOK_MARKETPLACE
  DEPOP
  MERCARI
  POSHMARK
  ETSY
}

// ─── Marketplace Connections ──────────────────────────────────────────────────

model MarketplaceConnection {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketplace  MarketplaceType
  accessToken     String
  refreshToken    String?
  sessionCookies  String?   // JSON array of Chrome cookie objects captured at connect time
  metadata        Json?     // marketplace-specific metadata (e.g. { csrfToken } for Mercari)
  expiresAt       DateTime?
  accountId       String? // external account ID
  accountName     String?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  listings Listing[]

  @@unique([userId, marketplace])
}

// ─── Inventory ────────────────────────────────────────────────────────────────

enum InventoryStatus {
  DRAFT
  ACTIVE
  SOLD
  ARCHIVED
}

enum Condition {
  NEW_WITH_TAGS
  NEW_WITHOUT_TAGS
  VERY_GOOD
  GOOD
  SATISFACTORY
}

model Source {
  id        String   @id @default(cuid())
  userId    String
  name      String
  parentId  String?
  createdAt DateTime @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Source?         @relation("SourceChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children Source[]        @relation("SourceChildren")
  items    InventoryItem[]
}

model InventoryItem {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId    String?
  source      Source?         @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  title       String
  description String?
  sku         String?
  condition   Condition       @default(GOOD)
  status      InventoryStatus @default(DRAFT)
  quantity    Int             @default(1)
  costPrice   Decimal?        @db.Decimal(10, 2)
  targetPrice Decimal?        @db.Decimal(10, 2)
  soldPrice   Decimal?        @db.Decimal(10, 2) // actual amount received when sold
  soldAt      DateTime? // when the item was marked sold
  soldVia     String? // where it sold, e.g. "In person", "eBay", "Facebook"
  soldNote    String? // optional note about the sale
  brand       String?
  category    String?
  tags        String[]
  weight      Decimal?        @db.Decimal(10, 2) // lbs
  dimensions  Json? // { length: number, width: number, height: number }
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  images     InventoryImage[]
  listings   Listing[]
  attributes InventoryAttribute[]
}

model InventoryImage {
  id        String        @id @default(cuid())
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  url       String
  key       String // storage key (S3/R2/Cloudinary)
  isPrimary Boolean       @default(false)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
}

model InventoryAttribute {
  id     String        @id @default(cuid())
  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name   String
  value  String
}

// ─── Listings ─────────────────────────────────────────────────────────────────

enum ListingStatus {
  DRAFT
  PENDING
  ACTIVE
  SOLD
  ENDED
  FAILED
}

model Listing {
  id                      String                @id @default(cuid())
  userId                  String
  user                    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventoryItemId         String
  inventoryItem           InventoryItem         @relation(fields: [inventoryItemId], references: [id])
  marketplaceConnectionId String
  marketplaceConnection   MarketplaceConnection @relation(fields: [marketplaceConnectionId], references: [id])
  marketplace             MarketplaceType
  externalId              String? // listing ID on the marketplace
  externalUrl             String?
  status                  ListingStatus         @default(DRAFT)
  price                   Decimal               @db.Decimal(10, 2)
  soldPrice               Decimal?              @db.Decimal(10, 2) // actual sale price when marked sold
  title                   String
  description             String?
  listedAt                DateTime?
  soldAt                  DateTime?
  endedAt                 DateTime?
  lastSyncAt              DateTime?
  syncError               String?
  syncFailCount           Int                   @default(0)
  publishAttempts         Int                   @default(0) // publish tries so far; capped at MAX_PUBLISH_ATTEMPTS
  marketplaceData         Json? // marketplace-specific data
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  syncEvents SyncEvent[]

  @@unique([userId, marketplace, externalId])
}

// ─── Subscriptions & Credits ──────────────────────────────────────────────────

enum PlanType {
  FREE
  SIDE_HUSTLE
  FULL_TIME
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  plan                 PlanType           @default(FREE)
  status               SubscriptionStatus @default(INACTIVE)
  billingInterval      String?            // "monthly" | "yearly" (null until a plan is chosen)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  trialEndsAt          DateTime?          // end of the 7-day free trial, if trialing
  cancelAtPeriodEnd    Boolean            @default(false)
  aiCredits            Int                @default(0) // monthly "smart AI credit" allotment, reset each cycle & on plan change
  bonusAiCredits       Int                @default(0) // purchased top-up credits, never expire
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  creditTransactions CreditTransaction[]
}

model CreditTransaction {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Int // positive = credits added, negative = credits used
  description    String
  listingId      String?
  // Stripe Checkout Session id that produced this ledger entry. Unique so a
  // one-time purchase is provisioned exactly once, whether the webhook or the
  // post-checkout verify endpoint gets there first.
  stripeSessionId String?     @unique
  createdAt      DateTime     @default(now())
}

// Dedup log for Stripe webhook deliveries. Stripe delivers events at-least-once
// (and may redeliver on retries), so we record each processed event id and skip
// any we've already handled. The @id primary key makes the insert atomic, so
// concurrent duplicate deliveries can't both be processed.
model StripeWebhookEvent {
  id        String   @id // Stripe event id (evt_...)
  type      String
  createdAt DateTime @default(now())
}

// ─── Mercari Extension Jobs ───────────────────────────────────────────────────

enum MercariJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model MercariJob {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId     String?
  status        MercariJobStatus @default(PENDING)
  payload       Json // listing data to fill into Mercari form
  errorMessage  String?
  externalId    String? // Mercari listing ID once created
  skipExtension Boolean          @default(false) // true = publish server-side via ZenRows only; hidden from the extension poll
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  completedAt   DateTime?
}

// ─── Poshmark Extension Jobs ──────────────────────────────────────────────────

enum PoshmarkJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model PoshmarkJob {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId    String?
  status       PoshmarkJobStatus @default(PENDING)
  payload      Json // listing data for Poshmark
  errorMessage String?
  externalId   String? // Poshmark listing ID once created
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  completedAt  DateTime?
}

// ─── Mercari Categories ───────────────────────────────────────────────────────

model MercariCategory {
  id             String    @id // Vendoo/Mercari category slug (e.g. "men_tops")
  label          String
  parentId       String?   // null = root-level category
  isLeaf         Boolean   @default(false)
  hasChildren    Boolean   @default(false)
  depth          Int       @default(0)
  fullPath       String[]  // breadcrumb labels ["Men", "Tops", "T-Shirts"]
  isSizeRequired Boolean   @default(false) // whether listings in this category require a sizeId
  sizeSchemaId   String?   // Mercari size schema ID (sizesSchemaId from Vendoo payload)
  payload        Json?     // parsed payload_text from Vendoo (may contain mercariCategoryId etc.)
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ─── Sync Events ──────────────────────────────────────────────────────────────

enum SyncEventType {
  PUBLISH
  UPDATE
  DELIST
  SOLD
  RELIST
  PRICE_UPDATE
  STATUS_CHECK
  ERROR
}

model SyncEvent {
  id        String        @id @default(cuid())
  listingId String
  listing   Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  type      SyncEventType
  status    String // success | failed | pending
  message   String?
  data      Json?
  createdAt DateTime      @default(now())
}
