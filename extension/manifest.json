{
  "manifest_version": 3,
  "name": "ReList – Mercari Crosslister",
  "version": "1.1.0",
  "description": "Automatically crosslist your ReList inventory to Mercari.",
  "permissions": ["tabs", "activeTab", "storage", "scripting", "cookies", "alarms"],
  "host_permissions": [
    "https://www.mercari.com/*",
    "https://api.omventa.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ReList Mercari Crosslister"
  }
}
