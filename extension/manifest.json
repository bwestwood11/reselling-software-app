{
  "manifest_version": 3,
  "name": "ReList – Crosslister",
  "version": "1.1.0",
  "description": "Automatically crosslist your ReList inventory to Mercari and Poshmark.",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "scripting",
    "cookies",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://www.mercari.com/*",
    "https://poshmark.com/*",
    "https://api.omventa.com/*",
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ReList Crosslister"
  }
}
